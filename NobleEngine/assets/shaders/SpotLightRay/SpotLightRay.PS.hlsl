// ============================================================================
// VolumetricSpotConeDX12.hlsl
// ----------------------------------------------------------------------------
// Unity URP版 "Custom/VolumetricSpotCone" を
// C++ / DirectX12 ベースの自作エンジンへ移植するためのHLSL。
// 
// 元Unity版の処理内容は極力そのまま維持し、
// Unity専用APIだけをDirectX12向けの明示的な処理へ置き換えています。
// 
// ============================================================================
// 【このシェーダーが何をしているか】
// ============================================================================
//
// 1. 元メッシュとして「球」を描画する。
// 2. Vertex Shaderで、その球頂点を円錐形の外殻へ変形する。
// 3. Pixel Shaderで
//
//      Camera位置
//          ↓
//      現在描画している円錐外殻Fragment
//
//    までの線分を複数点に分割する。
// 4. 各サンプル点について
//
//      「その点が円錐内部か」
//      「中心にどれだけ近いか」
//      「円錐先端からどれだけ遠いか」
//      「Reveal範囲内か」
//
//    を計算して密度を得る。
// 5. 密度を線分方向へ積算する。
// 6. 積算値を光量へ変換して加算合成する。
//
// つまり「本物の参加媒質シミュレーション」ではなく、
// 円錐内部に定義した疑似密度関数をレイ上で数値積分することで
// ボリュームライト風の見た目を作っています。
//
// ============================================================================
// 【Unity → DirectX12 置き換え一覧】
// ============================================================================
//
// Unity / URP                           DirectX12移植版
// -----------------------------------------------------------------------------
// UnityPerMaterial                     MaterialCB : register(b2)
// GetVertexPositionInputs              gWorld / gViewProjection を自分でmul
// GetCameraPositionWS                  CameraCB.gCameraPositionWS
// TransformWorldToObject              gWorldToObjectでmul
// TransformObjectToWorld              gWorldでmul
// TransformWorldToHClip               gViewProjectionでmul
// Blend One One                       PSOのBlendStateで ONE + ONE
// ZWrite Off                          DepthWriteMask = ZERO
// Cull Off                            CullMode = NONE
// Properties                          C++側の定数バッファ値
//
// ============================================================================
// 【このサンプルの行列規約】
// ============================================================================
//
// このファイルは
//
//   mul( float4(position,1), matrix )
//
// の「行ベクトル形式」で統一しています。
//
// つまり:
//
//   positionWS = mul(positionOS, gWorld)
//   positionCS = mul(positionWS, gViewProjection)
//
// です。
//
// C++側でDirectXMathを使う場合、エンジンがHLSLへ転送する行列を
// transposeしているかどうかによって、ここは合わせる必要があります。
//
// もし自作エンジンが
//
//   mul(matrix, vector)
//
// を標準にしているなら、このファイルのmul順を統一して変更してください。
//
// ============================================================================


// ============================================================================
// Camera Constant Buffer : b0
// ----------------------------------------------------------------------------
// フレーム単位で更新するカメラ情報。
// ============================================================================

cbuffer CameraCB : register(b0)
{
    // ------------------------------------------------------------------------
    // World Space -> Clip Space
    //
    //   Pclip = Pworld * ViewProjection
    //
    // DirectX12ではUnityのGetVertexPositionInputsのような便利関数がないため、
    // ViewProjection行列をCPU側から明示的に送ります。
    // ------------------------------------------------------------------------
    row_major float4x4 gViewProjection;


    // ------------------------------------------------------------------------
    // カメラのWorld Space位置。
    //
    // Unity:
    //
    //   GetCameraPositionWS()
    //
    // の代わり。
    //
    // float3の直後にpaddingを置き、
    // ConstantBufferの16byte境界を明示的に揃えています。
    // ------------------------------------------------------------------------
    float3 gCameraPositionWS;
    float  gCameraPadding0;
};


// ============================================================================
// Object Constant Buffer : b1
// ----------------------------------------------------------------------------
// このボリューム円錐オブジェクト固有のTransform。
// ============================================================================

cbuffer ObjectCB : register(b1)
{
    // Object Space -> World Space
    row_major float4x4 gWorld;


    // World Space -> Object Space
    //
    // CPU側では通常
    //
    //   worldToObject = inverse(world)
    //
    // を計算して送ります。
    //
    // Unity:
    //
    //   TransformWorldToObject(...)
    //
    // の代わりです。
    row_major float4x4 gWorldToObject;
};


// ============================================================================
// Material Constant Buffer : b2
// ----------------------------------------------------------------------------
// 元Unity ShaderLabのProperties / UnityPerMaterialに相当。
// ============================================================================

cbuffer MaterialCB : register(b2)
{
    // ========================================================================
    // Color
    // ========================================================================

    // 元Unity:
    //
    //   _Color = (1,0,0,0.15)
    //
    // rgb:
    //   最終的な光色。
    //
    // a:
    //   通常の透明度として使うのではなく、
    //   brightnessへ乗算する「密度倍率の一部」として使っています。
    float4 gColor;


    // 元Unity: _Intensity
    //
    // 積算した密度を最終光量へ変換するときの倍率。
    float gIntensity;


    // ========================================================================
    // Cone Shape
    // ========================================================================

    // 円錐先端側の直径相当値。
    //
    // 元シェーダーでは後で *0.5 するため、
    // 実際に半径として使われるのは
    //
    //   gTipRadius * 0.5
    //
    // です。
    float gTipRadius;


    // 円錐末端側も同様。
    float gEndRadius;


    // 円錐の長さ。
    //
    // Object Spaceで
    //
    //   Y = 0
    //
    // から
    //
    //   Y = -gConeLength
    //
    // まで伸びます。
    float gConeLength;


    // ========================================================================
    // Reveal / Volume
    // ========================================================================

    // 0～1。
    //
    // 円錐を先端からどこまで表示するか。
    //
    // height01 <= gReveal
    //
    // の範囲だけ密度を持ちます。
    float gReveal;


    // Reveal境界をどれだけ柔らかくするか。
    float gRevealSoftness;


    // レイマーチ積算値全体へかける密度倍率。
    float gDensity;


    // 円錐中心部の最大明るさ倍率。
    float gCenterBrightness;


    // ========================================================================
    // Volume continued
    // ========================================================================

    // 円錐外周をどれだけ柔らかく消すか。
    float gEdgeSoftness;


    // 奥へ行くほど暗くする量。
    float gDistanceFade;


    // レイマーチ回数。
    //
    // 元Unity版はfloat Propertyでしたが、
    // DX12側ではCPUから整数として渡した方が意味が明確なのでintにしています。
    //
    // Shader内では安全のため8～96へClampします。
    int gStepCount;


    // ConstantBuffer 16byte境界調整。
    float gMaterialPadding0;
};


// ============================================================================
// Vertex Input
// ----------------------------------------------------------------------------
// 元Unity版では球メッシュのPOSITIONしか使用していません。
// ============================================================================

struct VSInput
{
    float3 positionOS : POSITION;
};


// ============================================================================
// Vertex -> Pixel
// ============================================================================

struct VSOutput
{
    float4 positionCS : SV_POSITION;

    // Pixel ShaderでCameraからのrayを作るため、
    // 変形後頂点のWorld Space位置を渡します。
    float3 positionWS : TEXCOORD0;
};


// ============================================================================
// SphereToCone
// ----------------------------------------------------------------------------
// 元Unity版の SphereToCone() をそのまま移植。
// 
// ============================================================================
// 【重要な前提】
// ============================================================================
//
// 入力球メッシュのY範囲をおおむね
//
//   -0.5 ～ +0.5
//
// と想定しています。
//
// Unity版:
//
//   height01 = saturate(spherePosition.y + 0.5)
//
// なので:
//
//   sphere.y = -0.5 -> height01 = 0
//   sphere.y =  0.0 -> height01 = 0.5
//   sphere.y = +0.5 -> height01 = 1
//
// になります。
//
// さらに:
//
//   distanceFromSource = 1 - height01
//
// なので:
//
//   sphere.y = +0.5
//       -> distanceFromSource = 0
//       -> 円錐先端
//
//   sphere.y = -0.5
//       -> distanceFromSource = 1
//       -> 円錐末端
//
// です。
// ============================================================================

float3 SphereToCone(
    float3 spherePosition
)
{
    // ========================================================================
    // 1. 球頂点Yを0～1へ変換
    // ========================================================================
    //
    //   height01 =
    //      saturate(
    //          sphereY + 0.5
    //      )
    //
    // saturate(x) は
    //
    //   clamp(x, 0, 1)
    //
    // と同じです。
    // ========================================================================

    float height01 =
        saturate(
            spherePosition.y +
            0.5
        );


    // ========================================================================
    // 2. 光源先端からの距離率
    // ========================================================================
    //
    //   d = 1 - height01
    //
    // d = 0:
    //   円錐先端
    //
    // d = 1:
    //   円錐末端
    // ========================================================================

    float distanceFromSource =
        1.0 -
        height01;


    // ========================================================================
    // 3. 球頂点のXZ方向だけ取り出す
    // ========================================================================

    float2 xz =
        spherePosition.xz;


    // 元球上で中心軸からどれだけ離れていたか。
    //
    //   rOriginal =
    //      sqrt(x^2 + z^2)
    //
    float originalRadius =
        length(
            xz
        );


    float2 radialDirection =
        float2(
            0.0,
            0.0
        );


    // ========================================================================
    // 4. XZの「方向」だけ取得
    // ========================================================================
    //
    //   radialDirection =
    //      xz / |xz|
    //
    // ここで originalRadius の大きさそのものは捨てています。
    //
    // つまり元球表面の各頂点は、
    // その高さに対応した円錐断面の外周へ再配置されます。
    // ========================================================================

    if (
        originalRadius >
        0.00001
    )
    {
        radialDirection =
            xz /
            originalRadius;
    }


    // ========================================================================
    // 5. 現在高さの円錐半径
    // ========================================================================
    //
    // Lerp:
    //
    //   lerp(a,b,t)
    //      = a + (b-a)t
    //
    // よって:
    //
    //   diameterLikeValue =
    //      TipRadius
    //      + (EndRadius - TipRadius)
    //        * distanceFromSource
    //
    // さらに元シェーダーでは *0.5 しているため:
    //
    //   radius =
    //      0.5 *
    //      lerp(
    //          TipRadius,
    //          EndRadius,
    //          distanceFromSource
    //      )
    //
    // となります。
    //
    // したがってUnity Inspectorで設定していたTipRadius / EndRadiusは、
    // 実装上は「直径に近い値」として扱われています。
    // ========================================================================

    float radius =
        lerp(
            gTipRadius,
            gEndRadius,
            distanceFromSource
        )
        *
        0.5;


    // ========================================================================
    // 6. 円錐断面上のXZ位置
    // ========================================================================
    //
    //   coneXZ =
    //      radialDirection * radius
    //
    // ========================================================================

    float2 coneXZ =
        radialDirection *
        radius;


    // ========================================================================
    // 7. 円錐Y
    // ========================================================================
    //
    //   coneY =
    //      -distanceFromSource
    //      * ConeLength
    //
    // d=0:
    //
    //   y = 0
    //
    // d=1:
    //
    //   y = -ConeLength
    //
    // つまり円錐はObject Spaceの-Y方向へ伸びます。
    // ========================================================================

    float coneY =
        -distanceFromSource
        *
        gConeLength;


    return
        float3(
            coneXZ.x,
            coneY,
            coneXZ.y
        );
}


// ============================================================================
// VSMain
// ----------------------------------------------------------------------------
// Unity:
//
//   GetVertexPositionInputs(positionOS)
//
// を使っていた部分を、明示的な行列変換へ置き換えます。
// ============================================================================

VSOutput VSMain(
    VSInput input
)
{
    VSOutput output;


    // ------------------------------------------------------------------------
    // 1. 球メッシュを円錐外殻へ変形。
    // ------------------------------------------------------------------------

    float3 conePositionOS =
        SphereToCone(
            input.positionOS
        );


    // ------------------------------------------------------------------------
    // 2. Object Space -> World Space
    //
    //   Pws = Pos * World
    // ------------------------------------------------------------------------

    float4 positionWS4 =
        mul(
            float4(
                conePositionOS,
                1.0
            ),
            gWorld
        );


    // ------------------------------------------------------------------------
    // 3. World Space -> Clip Space
    //
    //   Pclip =
    //      Pworld * ViewProjection
    // ------------------------------------------------------------------------

    output.positionCS =
        mul(
            positionWS4,
            gViewProjection
        );


    output.positionWS =
        positionWS4.xyz;


    return output;
}


// ============================================================================
// GetConeDensity
// ----------------------------------------------------------------------------
// Object Space上の任意の点 p に対して、
// その地点の「ボリュームライト密度」を返す。
// 
// 戻り値0:
//   光なし
//
// 戻り値が大きい:
//   その地点を通るレイへ強く光量を加算
// ============================================================================

float GetConeDensity(
    float3 p
)
{
    // ========================================================================
    // 1. 円錐先端からの距離
    // ========================================================================
    //
    // 円錐は
    //
    //   y = 0
    //
    // から
    //
    //   y = -ConeLength
    //
    // へ伸びるため、
    //
    //   distanceFromSource = -p.y
    //
    // とすると
    //
    //   先端: 0
    //   末端: ConeLength
    //
    // という扱いやすい正の距離になります。
    // ========================================================================

    float distanceFromSource =
        -p.y;


    // 円錐先端より上側。
    if (
        distanceFromSource <
        0.0
    )
    {
        return 0.0;
    }


    // 円錐末端よりさらに奥。
    if (
        distanceFromSource >
        gConeLength
    )
    {
        return 0.0;
    }


    // ========================================================================
    // 2. 円錐長さを0～1へ正規化
    // ========================================================================
    //
    //   height01 =
    //      distance / ConeLength
    //
    // 先端:
    //   0
    //
    // 末端:
    //   1
    //
    // max(...,0.0001) は0除算防止。
    // ========================================================================

    float height01 =
        distanceFromSource /
        max(
            gConeLength,
            0.0001
        );


    // ========================================================================
    // 3. Reveal
    // ========================================================================
    //
    //   revealDifference =
    //      Reveal - height01
    //
    // height01 > Reveal:
    //
    //   revealDifference < 0
    //
    // になるので完全に非表示。
    //
    // つまりRevealは
    //
    //   0 -> 先端だけ
    //   1 -> 全長
    //
    // を意味します。
    // ========================================================================

    float revealDifference =
        gReveal -
        height01;


    if (
        revealDifference <=
        0.0
    )
    {
        return 0.0;
    }


    // ========================================================================
    // Reveal境界のフェード
    // ========================================================================
    //
    //   revealFade =
    //      saturate(
    //          revealDifference
    //          / RevealSoftness
    //      )
    //
    // Reveal境界直前では0～1の中間値になり、
    // ブツ切りではなく柔らかく消えます。
    // ========================================================================

    float revealFade =
        saturate(
            revealDifference /
            max(
                gRevealSoftness,
                0.0001
            )
        );


    // ========================================================================
    // 4. 現在高さでの円錐半径
    // ========================================================================
    //
    // VS側と同じ式:
    //
    //   radius =
    //      0.5 *
    //      lerp(
    //         TipRadius,
    //         EndRadius,
    //         height01
    //      )
    //
    // VSとPSで同じ円錐形状式を使うことが非常に重要です。
    //
    // 片方だけ式を変えると
    //
    //   「外殻形状」と
    //   「内部密度判定」
    //
    // が食い違います。
    // ========================================================================

    float radius =
        lerp(
            gTipRadius,
            gEndRadius,
            height01
        )
        *
        0.5;


    radius =
        max(
            radius,
            0.0001
        );


    // ========================================================================
    // 5. 中心軸からのXZ距離
    // ========================================================================
    //
    //   radialDistance =
    //      sqrt(
    //          p.x^2 +
    //          p.z^2
    //      )
    //
    // 円錐中心軸はObject SpaceのY軸です。
    // ========================================================================

    float radialDistance =
        length(
            p.xz
        );


    // 現在地点がその高さの円錐半径より外なら密度0。
    if (
        radialDistance >
        radius
    )
    {
        return 0.0;
    }


    // ========================================================================
    // 6. 半径方向を0～1へ正規化
    // ========================================================================
    //
    //   radial01 =
    //      radialDistance / radius
    //
    // 中心:
    //   0
    //
    // 外周:
    //   1
    // ========================================================================

    float radial01 =
        radialDistance /
        radius;


    // ========================================================================
    // 7. Edge Fade
    // ========================================================================
    //
    //   edgeStart =
    //      saturate(
    //         1 - EdgeSoftness
    //      )
    //
    // 例えば
    //
    //   EdgeSoftness = 0.25
    //
    // なら
    //
    //   edgeStart = 0.75
    //
    // つまり中心～半径75%まではほぼ100%、
    // 75%～100%でsmoothstepによって0へ落ちます。
    //
    //   edgeFade =
    //      1 - smoothstep(
    //              edgeStart,
    //              1,
    //              radial01
    //          )
    // ========================================================================

    float edgeStart =
        saturate(
            1.0 -
            gEdgeSoftness
        );


    float edgeFade =
        1.0 -
        smoothstep(
            edgeStart,
            1.0,
            radial01
        );


    // ========================================================================
    // 8. Center Fade
    // ========================================================================
    //
    //   centerFade =
    //      pow(
    //          saturate(1-radial01),
    //          0.75
    //      )
    //
    // 中心:
    //
    //   radial01 = 0
    //   centerFade = 1
    //
    // 外周:
    //
    //   radial01 = 1
    //   centerFade = 0
    //
    // exponent 0.75 < 1 なので、
    // 単純な線形より中心の明るさが比較的広く残ります。
    // ========================================================================

    float centerFade =
        pow(
            saturate(
                1.0 -
                radial01
            ),
            0.75
        );


    // ========================================================================
    // 9. 中心明度倍率
    // ========================================================================
    //
    //   centerBrightness =
    //      lerp(
    //          1,
    //          CenterBrightness,
    //          centerFade
    //      )
    //
    // 外周:
    //   centerFade=0
    //   -> 1倍
    //
    // 中心:
    //   centerFade=1
    //   -> CenterBrightness倍
    // ========================================================================

    float centerBrightness =
        lerp(
            1.0,
            gCenterBrightness,
            centerFade
        );


    // ========================================================================
    // 10. 奥行きFade
    // ========================================================================
    //
    //   farFactor =
    //      saturate(
    //          1 - DistanceFade
    //      )
    //
    //   lengthFade =
    //      lerp(
    //          1,
    //          farFactor,
    //          height01
    //      )
    //
    // 先端:
    //   height01=0
    //   -> 1
    //
    // 末端:
    //   height01=1
    //   -> farFactor
    //
    // DistanceFadeが大きいほど奥側が暗くなります。
    // ========================================================================

    float lengthFade =
        lerp(
            1.0,
            saturate(
                1.0 -
                gDistanceFade
            ),
            height01
        );


    // ========================================================================
    // 11. 最終地点密度
    // ========================================================================
    //
    //   densityAtPoint =
    //
    //      edgeFade
    //      * centerBrightness
    //      * lengthFade
    //      * revealFade
    //
    // ここではまだ gDensity や gIntensity は掛けません。
    //
    // それらはレイ全体を積分した後に1回だけ掛けます。
    // ========================================================================

    return
        edgeFade *
        centerBrightness *
        lengthFade *
        revealFade;
}


// ============================================================================
// PSMain
// ----------------------------------------------------------------------------
// Camera -> 現在の円錐外殻Fragmentまでをレイマーチし、
// GetConeDensity()を数値積分する。
// ============================================================================

float4 main(
    VSOutput input
) : SV_Target
{
    // ========================================================================
    // 1. World SpaceのCamera位置とSurface位置
    // ========================================================================

    float3 cameraWS =
        gCameraPositionWS;


    float3 surfaceWS =
        input.positionWS;


    // ========================================================================
    // 2. Camera -> Surface
    // ========================================================================
    //
    //   rayVectorWS =
    //      SurfaceWS - CameraWS
    //
    //   rayLengthWS =
    //      |rayVectorWS|
    //
    //   rayDirectionWS =
    //      rayVectorWS / rayLengthWS
    //
    // 元Unity版ではrayDirectionWSを計算していましたが、
    // その後の積分はObject Spaceで行うため、
    // 実際のレイマーチにはObject Space側の方向を使用します。
    //
    // ここでは元コードとの対応を明確にするため残しています。
    // ========================================================================

    float3 rayVectorWS =
        surfaceWS -
        cameraWS;


    float rayLengthWS =
        length(
            rayVectorWS
        );


    if (
        rayLengthWS <=
        0.0001
    )
    {
        return
            float4(
                0.0,
                0.0,
                0.0,
                0.0
            );
    }


    float3 rayDirectionWS =
        rayVectorWS /
        rayLengthWS;


    // 未使用警告を避けるため明示的に参照。
    // 「元Unity実装に存在するが、後段ではObject Spaceレイを使う」
    // という点を残すため削除していません。
    rayDirectionWS += 0.0;


    // ========================================================================
    // 3. Camera / Surface をObject Spaceへ変換
    // ========================================================================
    //
    // 元Unity:
    //
    //   cameraOS =
    //      TransformWorldToObject(cameraWS)
    //
    //   surfaceOS =
    //      TransformWorldToObject(surfaceWS)
    //
    // DX12:
    //
    //   PosOS =
    //      PosWS * WorldToObject
    //
    // ========================================================================

    float3 cameraOS =
        mul(
            float4(
                cameraWS,
                1.0
            ),
            gWorldToObject
        ).xyz;


    float3 surfaceOS =
        mul(
            float4(
                surfaceWS,
                1.0
            ),
            gWorldToObject
        ).xyz;


    // ========================================================================
    // 4. Object Space Ray
    // ========================================================================

    float3 rayOS =
        surfaceOS -
        cameraOS;


    float rayLengthOS =
        length(
            rayOS
        );


    if (
        rayLengthOS <=
        0.0001
    )
    {
        return
            float4(
                0.0,
                0.0,
                0.0,
                0.0
            );
    }


    float3 rayDirectionOS =
        rayOS /
        rayLengthOS;


    // ========================================================================
    // 【重要: なぜObject Spaceで積分するか】
    // ========================================================================
    //
    // GetConeDensity() が
    //
    //   y = 0 ～ -ConeLength
    //   radius = lerp(Tip,End,height)
    //
    // という「Object Spaceで定義された円錐」を判定するためです。
    //
    // World SpaceでRayMarchするなら、
    // 毎サンプル位置をObject Spaceへ変換する必要があります。
    //
    // この実装は最初にray全体をObject Spaceへ移すことで、
    // ループ内部で毎回行列変換しなくて済みます。
    //
    // ========================================================================
    // 【非等方Scaleについて】
    // ========================================================================
    //
    // 元Unity版も TransformWorldToObject 後のObject Space距離を
    // stepLengthに使っているため、
    // オブジェクトScaleによって見かけの積算密度が変化する可能性があります。
    //
    // この移植版では「元Unity版と同じ挙動」を優先し、そのままにしています。
    //
    // ワールドスケールに完全非依存な密度が必要なら、
    // 積分距離をWorld Space距離基準へ変更する必要があります。
    // ========================================================================


    // ========================================================================
    // 5. Step Count
    // ========================================================================
    //
    // 元Unity:
    //
    //   int stepCount =
    //      (int)clamp(
    //          _StepCount,
    //          8,
    //          96
    //      );
    //
    // DX12側ではintで渡しますが、
    // 不正値対策として同じClampを残します。
    // ========================================================================

    int stepCount =
        clamp(
            gStepCount,
            8,
            96
        );


    // ========================================================================
    // 6. 1サンプルあたりの移動距離
    // ========================================================================
    //
    //   stepLength =
    //      rayLengthOS / stepCount
    //
    // レイ全長をstepCount等分します。
    // ========================================================================

    float stepLength =
        rayLengthOS /
        stepCount;


    float accumulated =
        0.0;


    // ========================================================================
    // 7. 最初のサンプル位置
    // ========================================================================
    //
    //   travel =
    //      stepLength * 0.5
    //
    // 区間の端ではなく「各区間の中央」をサンプルする
    // Midpoint Ruleに近い形です。
    //
    // 例えば1区間長が1なら
    //
    //   0.0 ---- 0.5 ---- 1.0
    //
    //                    ↑
    //               0.5で評価
    //
    // することで、区間先頭だけを評価するより数値積分誤差を減らします。
    // ========================================================================

    float travel =
        stepLength *
        0.5;


    // ========================================================================
    // 8. Ray March
    // ========================================================================
    //
    // 最大96回。
    //
    // HLSLコンパイラへ最大回数を明示しつつ、
    // 実際はstepCountに達したらbreakします。
    // ========================================================================

    [loop]
    for (
        int i = 0;
        i < 96;
        ++i
    )
    {
        if (
            i >= stepCount
        )
        {
            break;
        }


        // --------------------------------------------------------------------
        // 現在サンプル位置
        //
        //   Psample =
        //      CameraOS
        //      + RayDirectionOS * travel
        // --------------------------------------------------------------------

        float3 samplePosition =
            cameraOS +
            rayDirectionOS *
            travel;


        // その地点の円錐密度。
        float density =
            GetConeDensity(
                samplePosition
            );


        // ====================================================================
        // 9. 数値積分
        // ====================================================================
        //
        // 連続な密度関数ρ(s)の線積分
        //
        //      L
        //     ∫ ρ(s) ds
        //      0
        //
        // を離散化して
        //
        //   Σ density_i * stepLength
        //
        // と近似しています。
        //
        // つまり:
        //
        //   accumulated +=
        //      density * Δs
        //
        // です。
        // ====================================================================

        accumulated +=
            density *
            stepLength;


        travel +=
            stepLength;
    }


    // ========================================================================
    // 10. 積算密度 -> Brightness
    // ========================================================================
    //
    //   brightnessRaw =
    //
    //      accumulated
    //      * Density
    //      * Intensity
    //      * Color.a
    //
    // gColor.a は「透明度」というより
    // ボリュームの全体係数として使用されています。
    // ========================================================================

    float brightness =
        accumulated *
        gDensity *
        gIntensity *
        gColor.a;


    // ========================================================================
    // 11. 指数圧縮
    // ========================================================================
    //
    //   brightness =
    //      1 - exp(-brightness)
    //
    // 性質:
    //
    //   x = 0
    //      -> 0
    //
    //   xが小さい
    //      -> ほぼx
    //
    //   xが大きい
    //      -> 1へ漸近
    //
    // つまり光量が極端に大きくなった場合の
    // 白飛び・爆発的増加をある程度圧縮します。
    //
    // 数学的にはBeer-Lambert系の
    //
    //   1 - e^-x
    //
    // に似た形ですが、
    // このシェーダーでは厳密な物理ベース透過率計算ではなく、
    // 見た目の圧縮として使っています。
    // ========================================================================

    brightness =
        1.0 -
        exp(
            -brightness
        );


    // ========================================================================
    // 12. 最終色
    // ========================================================================
    //
    //   finalRGB =
    //      Color.rgb * brightness
    //
    // PSO側が加算合成:
    //
    //   Dest =
    //      Src * ONE
    //      + Dest * ONE
    //
    // なので、既存画面へ光を足します。
    // ========================================================================

    float3 finalColor =
        gColor.rgb *
        brightness;


    return
        float4(
            finalColor,
            brightness
        );
}
